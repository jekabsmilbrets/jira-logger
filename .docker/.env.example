# Docker deployment configuration.
# Copy .env.example to .env and review each setting before starting.
# Keep .env private and out of version control; Jira settings are stored in the database.

# Application timezones
# Timezone used when converting stored calendar dates; instant timestamps stay UTC.
APP_INTERNAL_TIMEZONE=UTC

# Fallback timezone for displaying dates and calculating day/report boundaries.
# The configured user timezone in application settings takes precedence.
APP_DEFAULT_USER_TIMEZONE=Europe/Riga

# Browser access
# Regular expression matching browser origins allowed to call the API.
# Include the scheme, hostname and any development ports you use.
CORS_ALLOW_ORIGIN='^https?://(jira-logger\.io|localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Traefik dashboard
# Hostname used to route dashboard requests; configure DNS or /etc/hosts accordingly.
TRAEFIK_DASHBOARD_HOST=traefik.jira-logger.io

# Dashboard Basic Auth credentials in username:password-hash format.
# Replace the example hash before exposing the dashboard; keep real credentials private.
TRAEFIK_DASHBOARD_AUTH='admin:$$2y$$05$$OEJ1rq.qLRZo5tl/zQQ4/.x0NPgosA2ZDGklnroI4H3xInIGt9RTO'

# PostgreSQL cutover state
# Written by manager.sh only after database validation: migrated or not-required.
# Leave unset for a new deployment. The marker never replaces database validation.
# POSTGRES_MIGRATION_STATUS=
